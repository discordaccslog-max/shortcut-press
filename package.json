{
  "name": "shortcut-press",
  "private": true,
  "version": "2.0.0",
  "description": "Shortcut Press website and browser-based guides. Static site; these scripts build pages, practice files and the fulfillment kit, and run the tests.",
  "scripts": {
    "build": "node tools/site/build.mjs",
    "files": "node tools/files/build-files.mjs",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.mjs\"",
    "kit": "node tools/kit/kit.mjs",
    "serve": "node tools/serve.mjs"
  },
  "devDependencies": {
    "fast-formula-parser": "^1.0.19",
    "mp4-muxer": "^5.2.2",
    "playwright-core": "^1.65.0"
  }
}
